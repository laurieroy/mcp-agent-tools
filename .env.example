# Anthropic API key — required by the agent loop (src/client/agent_loop.py)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model name — required; never hard-coded in source
AGENT_MODEL=claude-3-5-haiku-latest

# Optional: override the default 5-turn bound on the agent loop
# AGENT_MAX_TURNS=5

# Open-Meteo weather API requires no key
